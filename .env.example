# Telegram
BOT_TOKEN=
WEBAPP_URL=https://yourdomain.example/miniapp

# Через запятую — telegram user_id всех, кому разрешён доступ к мини-аппу
ALLOWED_TELEGRAM_IDS=

# true — только для локальной разработки без настоящего Telegram-клиента.
# На проде ОБЯЗАТЕЛЬНО false, иначе API открыт всем без проверки.
DEV_MODE=true

# DB
DATABASE_URL=sqlite:///./doxbot.db

# Google Drive
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json

# Токен для подписи временных ссылок на скачивание
DOWNLOAD_TOKEN_SECRET=
